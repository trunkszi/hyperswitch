{
  "sourceLanguage": "en",
  "strings": {
    "%@ conflicts with %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 与 %2$@ 冲突"
          }
        }
      }
    },
    "%lld px": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 像素"
          }
        }
      }
    },
    "%lld windows": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个窗口"
          }
        }
      }
    },
    "+ ⇥ (Tab)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ ⇥ (Tab)"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About HyperSwitch": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 HyperSwitch"
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility lets HyperSwitch see the hotkeys and raise, close and minimize windows — without it nothing here works. Screen Recording adds the window thumbnails and the real window titles.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能让 HyperSwitch 能接收快捷键并抬升、关闭、最小化窗口——没有它这里的一切都无法工作。屏幕录制则提供窗口缩略图和真实的窗口标题。"
          }
        }
      }
    },
    "Activate the window switcher for": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换器的触发方式"
          }
        }
      }
    },
    "Active Screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动屏幕"
          }
        }
      }
    },
    "All windows": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部窗口"
          }
        }
      }
    },
    "Allow Space to keep the switcher open": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许用空格键让切换器保持打开"
          }
        }
      }
    },
    "App Switcher": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用切换器"
          }
        }
      }
    },
