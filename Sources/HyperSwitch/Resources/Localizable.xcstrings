    },
    "Interface language": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言"
          }
        }
      }
    },
    "It keeps running and its keyboard shortcuts still work. To bring the menu bar icon back, open HyperSwitch again from your Applications folder.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它仍在运行，快捷键照常有效。想让菜单栏图标回来，从「应用程序」文件夹再次打开 HyperSwitch 即可。"
          }
        }
      }
    },
    "Keep the selection in the central visual band": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让选中项保持在视觉中央区域"
