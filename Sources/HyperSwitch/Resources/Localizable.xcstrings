          }
        }
      }
    },
    "Hide the menu bar icon?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要隐藏菜单栏图标吗？"
          }
        }
      }
    },
    "High": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高"
          }
        }
      }
    },
    "Hold a modifier and press Tab to see every open window as a preview — including windows on other desktops and ones you have minimized — then release on the one you want.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修饰键并按 Tab，即可看到所有已打开窗口的预览——包括其他桌面上的窗口和已最小化的窗口——在想要的那个上松手即可切过去。"
          }
        }
      }
    },
    "HyperSwitch": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperSwitch"
          }
        }
      }
    },
    "HyperSwitch draws only the nearby 5–7 cards. All results remain reachable, while layout and thumbnail work stay bounded.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperSwitch 只绘制附近的 5–7 张卡片。所有结果依然可以走到，而布局和缩略图的开销保持有界。"
          }
        }
      }
    },
    "HyperSwitch is now hidden": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperSwitch 已隐藏"
          }
        }
      }
    },
    "If enabled, HyperSwitch keeps running in the background and is automatically started when you log in.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后 HyperSwitch 会常驻后台运行，并在你登录时自动启动。"
          }
        }
      }
    },
    "Include minimized windows": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含已最小化的窗口"
          }
        }
      }
    },
    "Include windows from other screens": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含其他屏幕上的窗口"
