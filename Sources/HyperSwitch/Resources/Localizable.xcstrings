            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Apply recommendation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用推荐值"
          }
        }
      }
    },
    "Automatically activate the current app after": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动激活当前选中的应用，延迟"
          }
        }
      }
    },
    "Background color": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景颜色"
          }
        }
      }
    },
    "Blur window background": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊窗口背景"
          }
        }
      }
    },
    "Both apply only while HyperSwitch is drawing the ⌘Tab switcher. With previews off the system's own switcher takes over and neither has any effect.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这两项仅在 HyperSwitch 自绘 ⌘Tab 切换器时生效。关闭预览后由系统自带的切换器接管，两项都不起作用。"
          }
        }
      }
    },
    "Calibrate activation delay": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准激活延迟"
          }
        }
      }
    },
    "Calibrate delay…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准延迟…"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Checks HyperSwitch bindings and enabled macOS symbolic shortcuts. macOS does not provide a reliable list of shortcuts owned privately by other apps.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 HyperSwitch 的按键绑定与已启用的 macOS 系统快捷键。macOS 不提供其他应用私有快捷键的可靠列表。"
          }
        }
      }
    },
    "Close": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Comfort display shows at most five nearby windows with stronger selection outlines and larger text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "舒适显示最多呈现附近五个窗口，选中描边更明显，文字更大。"
          }
        }
      }
    },
    "Comfort display: larger labels and targets": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
