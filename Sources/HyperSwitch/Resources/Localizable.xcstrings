    "Enable search and grouping at": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用搜索与分组的阈值"
          }
        }
      }
    },
    "Every preference returns to the value HyperSwitch ships with, and it stops opening at login. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一项设置都会回到 HyperSwitch 出厂时的值，并且不再随登录启动。此操作无法撤销。"
          }
        }
      }
    },
    "Fade out": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "淡出"
          }
        }
      }
    },
    "Full size preview delay": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
